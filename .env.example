# Public site URL (metadata / OG tags)
NEXT_PUBLIC_SITE_URL=https://onepercentclub-delta.vercel.app

# Messenger username of your Facebook page (the part after m.me/ or facebook.com/).
# Orders open https://m.me/<username> with the order text already copied.
NEXT_PUBLIC_MESSENGER_USERNAME=

# Social links (Instagram defaults to the club's account; Facebook is hidden until set)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/theonepercentclubbb
NEXT_PUBLIC_FACEBOOK_URL=
